# ============================================================================
# Baliqchi tumani O'quvchilar Kengashi Platformasi — Environment Variables
# Ushbu faylni .env.local sifatida nusxalang va Supabase kalitlarini kiriting.
# MAXFIY KALITLARNI HECH QACHON KODGA YOKI GITHUB'GA YOZMANG!
# ============================================================================

# Supabase Public (Brauzerda ham ishlaydi, RLS bilan himoyalangan)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase Service Role Key (FAQAT SERVERDA! Admin amallari va audit uchun)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Platforma asosiy URL manzili (Vercel production URL yoki localhost)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telefon raqamlarini login uchun ichki identifikatorga aylantirish domeni
AUTH_PHONE_DOMAIN=baliqchi-kengash.uz

# Telefon/IP xeshlash uchun maxfiy tuz (kamida 32 belgi)
SECURITY_HASH_SALT=replace-with-strong-random-32-char-secret

# Telegram Bot OTP tasdiqlash (Bepul va eng kuchli himoya)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
